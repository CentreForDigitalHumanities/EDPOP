{{! Lots of standalone tags. Good news: they leave no output. }}
{{#isFirst}}
<!-- rowspan=0 makes the cell extend to the end of the current rowgroup -->
<th rowspan=0
    scope=rowgroup
    title="fieldInfo.description"
>{{fieldInfo.name}}</th>
{{/isFirst}}
<td
{{#edit}}
    title="{{getPublishedDate}}{{#updatedDate}} (updated: {{.}}){{/updatedDate}}"
{{/edit}}
    class="vre-field-value"
>
{{#outdatedText}}
    {{#shortOriginalText}}
    <del title="{{originalText}}">{{.}}</del>
    {{/shortOriginalText}}
    {{^shortOriginalText}}
    <del><span class="original-text">{{originalText}}</span></del>
    {{/shortOriginalText}}
{{/outdatedText}}
{{#hasCurrentText}}
    {{#edit}}
    <ins>
    {{/edit}}
    {{#authorityRecord}}
        <a href="/record/{{&.}}" target=_blank title="Go to linked record">
    {{/authorityRecord}}
            <span class="original-text">{{currentText}}</span>
    {{#authorityRecord}}
        </a>
    {{/authorityRecord}}
    {{#edit}}
    </ins>
    {{/edit}}
{{/hasCurrentText}}
{{#hasImage}}
    <span class="fa-solid fa-image" role=img aria-label="with image"></span>
{{/hasImage}}
{{#edit}}
    <span class="authored-by">@{{getAuthor.getUsername}}</span>
{{/edit}}
</td>
<td class="field-value-buttons">
{{#field}}
    <a class="fa-solid fa-plus comment text-decoration-none"
       role="button"
       tabindex=0
       title="Make addition"
    ></a>
{{/field}}
{{^field}}
    {{^dangling}}
        {{^deletion}}
    <a class="fa-solid fa-pen comment text-decoration-none"
       role="button"
       tabindex=0
       title="Edit"
    ></a>
        {{/deletion}}
    {{/dangling}}
    {{#dangling}}
    <a class="fa-solid fa-link-slash comment text-decoration-none"
       role="button"
       tabindex=0
       title="Edited value no longer present on original record; relink"
    ></a>
    {{/dangling}}
    <a class="fa-solid fa-xmark comment text-decoration-none"
       role="button"
       tabindex=0
       {{#uncorrected}}
       title="Mark original value as deleted"
       {{/uncorrected}}
       {{#correction}}
       title="Undo correction"
       {{/correction}}
       {{#deletion}}
       title="Undo deletion"
       {{/deletion}}
       {{#addition}}
       title="Remove addition"
       {{/addition}}
    ></a>
{{/field}}
</td>
