<div class="card mb-2">
    {{#previewUrl}}
        <img src="{{.}}" alt="Digitization preview" class="card-img-top">
    {{/previewUrl}}
    <div class="card-body">
        {{#summaryText}}
            <p class="card-text">{{.}}</p>
        {{/summaryText}}
        {{#iiifManifest}}
            <p class="card-text"><a href="{{.}}" target="_blank">Get IIIF manifest</a></p>
            <p><a href="/mirador?manifest={{encodedManifestUrl}}" target="_blank">Show in Mirador</a></p>
        {{/iiifManifest}}
        {{#imageUrl}}
            <p class="card-text"><a href="{{.}}" target="_blank">Show digitization</a></p>
        {{/imageUrl}}
        {{#empty}}
            <p class="card-text">No digitization available</p>
        {{/empty}}
    </div>
</div>
